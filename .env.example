# Copy this file to a new file named .env and fill in your own values.
# Never share or commit your real .env file.

# Where MongoDB is. Use your own Atlas connection string, or leave this line out
# to use a MongoDB running on your own computer (mongodb://127.0.0.1:27017/courtside).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/courtside?retryWrites=true&w=majority

# Signs login tokens. Any long random text works. If you leave this out, logins
# simply end whenever the server restarts.
JWT_SECRET=replace-this-with-a-long-random-string

# Optional. The website runs at http://localhost:3000 unless you change this.
PORT=3000
